# Everything cargo: the package plus the fmt, clippy and test checks, all sharing
# one compilation of the dependency graph
{ pkgs, craneLib }:

let
  libPath = pkgs.lib.makeLibraryPath (
    with pkgs;
    [
      gmp
      nettle
      pcsclite
    ]
  );

  # The cargo sources: Cargo.{toml,lock} and every *.rs and *.toml, so build.rs, tests/ and
  # rustfmt.toml survive, but for the hardware harness, whose expectations and results are no
  # input of the crate and must not rebuild it. Of the book only the option reference, which
  # a test holds to the command line; every other chapter can change without a rebuild.
  src =
    let
      fs = pkgs.lib.fileset;
    in
    fs.toSource {
      root = ../.;
      fileset = fs.unions [
        (fs.difference (fs.fromSource (craneLib.cleanCargoSource ../.)) ../harness)
        ../docs/options-reference.md
      ];
    };

  commonArgs = {
    inherit src;
    strictDeps = true;

    nativeBuildInputs = with pkgs; [
      pkg-config
      rustPlatform.bindgenHook
    ];
    buildInputs = with pkgs; [
      gmp
      nettle
      pcsclite
    ];
  };

  # The external tools the interoperability tests drive; build.rs looks for them while the
  # tests compile, so every check that builds the tests needs them
  testTools = with pkgs; [
    sequoia-sq
    gnupg
    openssl
    nss.tools
  ];

  # Dependencies compiled once, reused by the package build, clippy and the tests
  cargoArtifacts = craneLib.buildDepsOnly commonArgs;

  # A destructive hardware suite as a test executable, for the virtual card checks to
  # run against their card: `cargo test` compiles such a suite and discards it, this
  # keeps it, with the libraries the card stack loads at runtime on its path
  mkSuite =
    {
      name,
      test,
      tools ? [ ],
      wrapperArgs ? [ ],
    }:
    craneLib.buildPackage (
      commonArgs
      // {
        inherit cargoArtifacts;

        pname = "mind-the-gap-${name}-suite";
        doCheck = false;
        cargoBuildCommand = "cargo test --profile release --no-run --features destructive-hardware-tests --test ${test}";

        nativeBuildInputs = commonArgs.nativeBuildInputs ++ [ pkgs.makeWrapper ] ++ tools;

        # The harness names the binary with a hash; it is the one executable file
        # among the metadata next to it
        installPhaseCommand = ''
          mkdir -p $out/bin
          cp "$(find target/release/deps -maxdepth 1 -type f -executable -name '${test}-*')" \
            $out/bin/${name}-suite
          wrapProgram "$out/bin/${name}-suite" --prefix LD_LIBRARY_PATH : "${libPath}" \
            --prefix PATH : "${pkgs.lib.makeBinPath tools}"${
              pkgs.lib.optionalString (wrapperArgs != [ ]) " ${pkgs.lib.escapeShellArgs wrapperArgs}"
            }
        '';
      }
    );
in
{
  # The developer reference, published next to the book under /rustdoc. Private
  # items on purpose: the interesting functions of the builders are private, and
  # this is documentation for people changing the crate, not consuming it
  doc = craneLib.cargoDoc (
    commonArgs
    // {
      inherit cargoArtifacts;
      cargoDocExtraArgs = "--no-deps --document-private-items";

      # A broken intra-doc link is a build failure, matching the book's link check
      RUSTDOCFLAGS = "-D warnings";
    }
  );

  package = craneLib.buildPackage (
    commonArgs
    // {
      inherit cargoArtifacts;

      # Tests run exactly once, in the test check below, where the external tools
      # they gate on are actually present
      doCheck = false;

      nativeBuildInputs = commonArgs.nativeBuildInputs ++ [ pkgs.makeWrapper ];

      # mind-the-build executes during postInstall and loads these at runtime
      LD_LIBRARY_PATH = libPath;

      postInstall = ''
        # Man pages and completion support are generated by additional binary
        $out/bin/mind-the-build $out
        rm $out/bin/mind-the-build

        # Ensure needed dependencies can be located
        wrapProgram "$out/bin/mind-the-gap" --prefix LD_LIBRARY_PATH : "${libPath}"
      '';
    }
  );

  checks = {
    fmt = craneLib.cargoFmt { inherit src; };

    # cargo-deny's offline checks: licenses, bans and source provenance, per
    # deny.toml (cleanCargoSource keeps every *.toml, so the config is in src).
    # The advisories check needs the RustSec database from the network, which the
    # sandbox rightly refuses -- CI runs that part in a separate workflow step.
    deny = craneLib.cargoDeny { inherit src; };

    # The same tools as the test check, so `--all-targets` actually lints the
    # gated tests instead of build.rs compiling them out
    clippy = craneLib.cargoClippy (
      commonArgs
      // {
        inherit cargoArtifacts;
        cargoClippyExtraArgs = "--all-targets -- --deny warnings";

        nativeBuildInputs = commonArgs.nativeBuildInputs ++ testTools;
      }
    );

    # The tools live in nativeBuildInputs, not checkInputs: build.rs probes PATH
    # to decide which tests exist at all, and it runs while the tests compile. A
    # tool missing at that moment silently ignores its tests, which is the exact
    # failure mode build.rs was written to surface.
    test = craneLib.cargoTest (
      commonArgs
      // {
        inherit cargoArtifacts;

        nativeBuildInputs = commonArgs.nativeBuildInputs ++ testTools;

        # Expose shared libraries so the test binaries can load them at runtime
        LD_LIBRARY_PATH = libPath;

        # GnuPG can not be run without access to its home dir
        GNUPGHOME = "/tmp";
      }
    );

    # The destructive on-card suites are compiled out of every ordinary run by the
    # feature interlock, so nothing above type-checks them and they would rot
    # silently. Compile them -- `--no-run`, so no card is ever touched -- to keep
    # them honest.
    hardware-tests = craneLib.cargoTest (
      commonArgs
      // {
        inherit cargoArtifacts;

        pname = "mind-the-gap-hardware-tests";
        cargoExtraArgs = "--features destructive-hardware-tests";
        cargoTestExtraArgs = "--no-run";

        nativeBuildInputs = commonArgs.nativeBuildInputs ++ testTools;
      }
    );
  };

  # The destructive PIV suite for the virtual PIV check: the card-level entry points
  # prove on-card signing and key agreement, which `piv check` cannot (it compares
  # public keys)
  pivSuite = mkSuite {
    name = "piv";
    test = "piv_hardware";
  };

  # The OpenPGP suite the same way, for the virtual OpenPGP check. gpg is in the build
  # so that build.rs enables the gpg steps, and on the wrapper's path so they can run
  pgpSuite = mkSuite {
    name = "pgp";
    test = "pgp_hardware";
    tools = [ pkgs.gnupg ];
  };

  # The PIV suite as real cards run it, through the hardware test harness: with the tools
  # of its end-use steps in the build, so that build.rs enables them, and on its path with
  # the modules they load, as the dev shell has them
  pivHardwareSuite = mkSuite {
    name = "piv-hardware";
    test = "piv_hardware";
    tools = [
      pkgs.openssl
      pkgs.opensc
      pkgs.openssh
      pkgs.nss.tools
    ];
    wrapperArgs = [
      "--set"
      "PKCS11_MODULE"
      "${pkgs.opensc}/lib/opensc-pkcs11.so"
      "--set"
      "OPENSSL_PKCS11_PROVIDER"
      "${pkgs.pkcs11-provider}/lib/ossl-modules/pkcs11.so"
    ];
  };
}
