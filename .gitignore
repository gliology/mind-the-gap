/target
/book

# Build symlink and direnv state
/result*
/.direnv
/.envrc

# Local scratch: exported certificates, keys and seeds must never be committed.
# Anchored to the repository root, so a deliberate fixture under tests/ or docs/
# is not silently ignored.
/*.asc
/*.pem
/*.der
/*.pub
/*.gpg
/test.sh

# Python bytecode from running the asset exporter in place
__pycache__/

# The serials of the spare cards the hardware harness may reset, by name: local only
/.env
